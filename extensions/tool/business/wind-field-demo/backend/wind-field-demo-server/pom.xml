<!--
  扩展包后端骨架模板（占位符由 scripts/create-extension.sh 的 backend/with-backend 开关自动替换，
  手工实例化见同目录 README.md 的占位符表）：
    wind-field-demo-server    服务 id（kebab-case；= manifest.backendServices[].serviceId = Nacos 注册名）
    风场  能力包中文名
  集成约定：
  - parent 指向 vendored 根 pom（file://maven-repo，相对本 pom 六层到仓根）——模板仓实例化形态，
    独立构建不依赖平台仓（平台仓内实例化才是 6 层 relativePath 回 platform/backend/ruoyi-cloud）
  - 独立构建：禁止挂进 ruoyi-modules/pom.xml 的 <modules> 聚合（PLUGIN_DEVELOPMENT §3.3）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ruoyi</groupId>
        <artifactId>ruoyi</artifactId>
        <version>3.6.8</version>
        <relativePath>../../../../../../maven-repo/com/ruoyi/ruoyi/3.6.8/ruoyi-3.6.8.pom</relativePath>
    </parent>
    <artifactId>wind-field-demo-server</artifactId>
    <description>风场 后端微服务</description>

    <dependencies>
        <!-- RuoYi 通用安全（@RequiresPermissions/@InnerAuth/R 返回体；纯内部服务可移除） -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Nacos 注册与配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Actuator 健康端点（manifest healthEndpoint 约定 /<svc>/actuator/health） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>agrsearth-vendored</id>
            <name>AGRSEarth vendored com.ruoyi artifacts</name>
            <url>file://${project.basedir}/../../../../../../maven-repo</url>
        </repository>
    </repositories>

</project>
