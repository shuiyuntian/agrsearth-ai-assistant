{
  "name": "@agrsearth/vite-config",
  "version": "1.3.0",
  "description": "能力包公共 Vite Library 配置（defineExtensionConfig/defineAdminUiConfig + host-contract 构建期硬校验 + 包级 CSS 作用域）",
  "type": "module",
  "private": true,
  "main": "vite.base.ts",
  "types": "vite.base.ts",
  "exports": {
    ".": {
      "import": "./dist/vite.base.js",
      "types": "./vite.base.ts"
    },
    "./admin": {
      "import": "./dist/vite.admin.base.js",
      "types": "./vite.admin.base.ts"
    },
    "./css-scope": {
      "import": "./dist/css-scope.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "postcss": "8.5.32",
    "postcss-selector-parser": "6.1.6",
    "tailwindcss": "^3.4.19"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "vite": "^5.3.1 || ^6.4.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.4.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-setup-extend-plus": "^1.0.1",
    "vite": "6.4.6"
  }
}
