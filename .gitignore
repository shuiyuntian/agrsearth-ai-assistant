# 插件模板仓独立成仓时的本地忽略规则（位于平台仓内时由仓根 .gitignore 统一覆盖）
node_modules/
dist/
build/
**/admin-ui/auto-imports.d.ts
docs/html/
logs/
target/
# 后端 dev 档 H2 文件库（本地测试数据，不入库）
**/backend/*/data/
*.tar.gz
.DS_Store
.env
.env.local
.env.*.local
# vendored Maven 仓构件（pom/jar/sha1）必须随仓入库——豁免仓根 .gitignore 的 *.jar 排除
!maven-repo/**/*.jar
