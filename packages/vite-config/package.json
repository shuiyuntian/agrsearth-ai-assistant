{
  "name": "@agrsearth/vite-config",
  "version": "1.2.0",
  "description": "能力包公共 Vite Library 配置（defineExtensionConfig/defineAdminUiConfig + host-contract 构建期硬校验）",
  "type": "module",
  "private": true,
  "main": "vite.base.ts",
  "types": "vite.base.ts",
  "exports": {
