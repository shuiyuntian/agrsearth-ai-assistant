  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.5",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-setup-extend-plus": "^1.0.1",
    "vite": "^6.4.4"
